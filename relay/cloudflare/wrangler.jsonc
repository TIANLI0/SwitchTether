{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "switchtether-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Relay keys: `npx wrangler secret put SWITCHTETHER_RELAY_KEYS` (comma-separated, from
  // `switchtether-relay genkey`). Passed to the container in src/index.ts.
  "secrets": { "required": ["SWITCHTETHER_RELAY_KEYS"] },
  "containers": [
    {
      // The same relay as the Docker deployment: relay/Dockerfile, built by wrangler.
      "class_name": "RelayContainer",
      "image": "../Dockerfile",
      "image_build_context": "..",
      // Exactly one instance: a phone and its desktop must reach the same relay process.
      "max_instances": 1,
      // "lite" (1/16 vCPU) is cheaper; "basic" (1/4 vCPU) leaves room for several busy tunnels.
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "RelayContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayContainer"] }]
}
