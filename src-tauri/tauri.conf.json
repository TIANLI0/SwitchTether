{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SwitchTether",
  "mainBinaryName": "switchtether",
  "version": "0.1.29",
  "identifier": "io.github.tianli0.switchtether",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "node scripts/build-shim.mjs && pnpm run dev:renderer",
    "beforeBuildCommand": "node scripts/build-shim.mjs --release && pnpm run build:renderer"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "",
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 14,
          "y": 16
        },
        "width": 1000,
        "height": 650,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http:; script-src 'self' 'sha256-ls27Lc1OytcVawXPVMplz6LyKz2i9KYAVBw3u79qyB4='; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https: http:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "template": "wix/per-user-main.wxs"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "externalBin": [
      "binaries/switchtether-shim"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "switchtether"
        ]
      }
    },
    "updater": {
      "pubkey": "SWITCHTETHER_UPDATER_PUBKEY_NOT_CONFIGURED",
      "endpoints": [
        "https://github.com/TIANLI0/SwitchTether/releases/latest/download/latest.json"
      ]
    }
  }
}
