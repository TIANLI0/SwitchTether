<?xml version="1.0" encoding="UTF-8"?>
<!-- Shared Android Lint configuration for :app, :core:ui and :core:security (lintConfig). -->
<lint>
    <!-- Depend on what was published upstream today, not on the code: they would turn green
         builds red over time. Dependency bumps are deliberate (gradle/libs.versions.toml). -->
    <issue id="NewerVersionAvailable" severity="ignore" />
    <issue id="GradleDependency" severity="ignore" />
    <issue id="AndroidGradlePluginVersion" severity="ignore" />
    <!-- local.properties is per machine and never committed. -->
    <issue id="PropertyEscape">
        <ignore path="local.properties" />
        <ignore path="../local.properties" />
    </issue>
</lint>
