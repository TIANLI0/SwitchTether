<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Normal-level; the runtime prerequisite of the connectedDevice FGS type for a network link. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Self-update: installs a downloaded release only after SHA-256 and signing-certificate checks. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- LAN discovery (_switchtether._tcp via NSD): a multicast lock held only while discovering. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Android 17 (targetSdk 37): TCP to the desktop's LAN address and NSD/mDNS need this runtime
         permission (NEARBY_DEVICES group). Requested with a rationale at pairing / first LAN connect. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Android 16+: an active session's ongoing notification may be promoted (Live Update). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Android 14+: large uploads / downloads run as user-initiated data transfer jobs (normal permission). -->
    <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />

    <!-- Optional Bluetooth association with the user's computer (CompanionDeviceManager, user picks
         it in the system dialog): battery exemption while associated, presence wake-ups, and
         listing already-bonded computers (BLUETOOTH_CONNECT, asked only from that sheet). -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_RUN_IN_BACKGROUND" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND" />
    <uses-permission android:name="android.permission.REQUEST_OBSERVE_COMPANION_DEVICE_PRESENCE" />

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.software.companion_device_setup" android:required="false" />

    <!-- Package visibility for the settings pages offered from the pin / live-notification sheet. -->
    <queries>
        <intent>
            <action android:name="android.settings.APP_NOTIFICATION_PROMOTION_SETTINGS" />
        </intent>
        <intent>
            <action android:name="oplus.fluid.seeding.settings.main" />
        </intent>
    </queries>

    <!--
      allowBackup=false: pairing metadata is useless without the Keystore keys (which are never
      backed up), and restoring it elsewhere would only produce a broken pairing.
    -->
    <application
        android:name=".SwitchTetherApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.SwitchTether"
        android:enableOnBackInvokedCallback="true"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="36">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Direct Share targets (session conversation shortcuts), see res/xml/shortcuts.xml. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <!-- Pairing links scanned by the system camera open the app on the confirm screen.
                 Nothing is paired without the user's explicit confirmation. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="switchtether" android:host="pair" />
            </intent-filter>
            <!-- "Share to SwitchTether": text, links, images and files from other apps. The user picks
                 a session (or a new one) and reviews the composer; nothing is sent automatically. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <!-- One detail page per activity: the system draws opening a page and the predictive back
             gesture to the page under it. -->
        <activity
            android:name=".PageActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density" />
        <!--
          The `:link` process (docs/ANDROID_UI.md §38): background connection, notifications, Live
          Updates, widget, port forwards. Everything below with android:process=":link" runs there;
          the UI process can be reclaimed once the app is left.
        -->
        <!-- Keeps the events WebSocket to the paired computer alive in the background (user toggle). -->
        <service
            android:name=".notify.MonitorService"
            android:process=":link"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
        <!-- Bound by the UI process while the app is in use (messages UI ↔ link). -->
        <service
            android:name=".link.LinkBridgeService"
            android:process=":link"
            android:exported="false" />
        <!-- Periodic recovery handed over by ReconnectWorker (WorkManager runs in the UI process). -->
        <receiver
            android:name=".link.LinkReceiver"
            android:process=":link"
            android:exported="false" />
        <!-- Bound by the system when the associated computer connects / disconnects over Bluetooth. -->
        <service
            android:name=".connection.CompanionPresenceService"
            android:process=":link"
            android:exported="true"
            android:permission="android.permission.BIND_COMPANION_DEVICE_SERVICE">
            <intent-filter>
                <action android:name="android.companion.CompanionDeviceService" />
            </intent-filter>
        </service>
        <!-- PackageInstaller session results for self-update (not exported: PendingIntent only). -->
        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />
        <!-- Home-screen widget "待处理 / 运行中" (opens sessions only; never approves). -->
        <receiver
            android:name=".widget.StatusWidgetProvider"
            android:process=":link"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_status_info" />
        </receiver>
        <!-- Allow / deny / answer / reply buttons of ordinary notifications (PendingIntents only). -->
        <receiver
            android:name=".notify.NotifyActionReceiver"
            android:process=":link"
            android:exported="false" />
        <!-- Keep-alive alarm of the monitor service (checks / restores the connection while asleep). -->
        <receiver
            android:name=".connection.KeepAlive$Receiver"
            android:process=":link"
            android:exported="false" />
        <!-- Buttons / swipe-away of pinned tasks' Live Updates (PendingIntents only). -->
        <receiver
            android:name=".notify.LiveUpdateActionReceiver"
            android:process=":link"
            android:exported="false" />
        <!-- Boot / app-update recovery: schedules WorkManager check (never bypasses FGS rules). -->
        <receiver
            android:name=".connection.BootReceiver"
            android:process=":link"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- User-initiated data transfer jobs of large uploads / downloads (one per transfer, never rescheduled). -->
        <service
            android:name=".transfer.TransferJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- Cancel on a transfer's progress notification (PendingIntent only). -->
        <receiver
            android:name=".transfer.TransferActionReceiver"
            android:exported="false" />
        <!-- WorkManager is initialised on demand (SwitchTetherApp is its Configuration.Provider), so the
             `:link` process can enqueue work while jobs run in the UI process only. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
        <!-- Hands cached / downloaded remote files to viewers and other apps (read grant only; never a file:// URI). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>
    </application>
</manifest>
