<?xml version="1.0" encoding="utf-8"?>
<!-- No cleartext except to this phone's own loopback, where SwitchTether's port forwards listen
     (DeepSeek Harness Web in the app's WebView; the bytes travel to the computer inside the pinned
     mTLS connection). Desktop trust is NOT configured here: the app pins the desktop's self-signed
     leaf certificate (SHA-256 from the pairing QR) in its own TrustManager. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
