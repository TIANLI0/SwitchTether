<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="widget_surface">#FFFFFFFF</color>
    <color name="widget_primary">#FF1A1A1A</color>
    <color name="widget_secondary">#FF7A7A7A</color>
    <color name="widget_accent">#FF1F6BFF</color>
    <color name="widget_warn">#FFE8A23B</color>
    <style name="WidgetRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/widget_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:visibility">gone</item>
    </style>
</resources>
